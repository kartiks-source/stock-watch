# Stock-out Watch: every variable the code reads (grep process.env). No real values here, ever.
# Secrets go in Railway variables or Azure Key Vault (SECURITY.md). Blank = off / default.

# --- Server ---
# Port to listen on (Railway sets it; 0 = any free port, for tests)
PORT=4400
# Where store.json, onorder.json, decisions.json, catalog.json, secret and backups/ live (mount a volume here; /data in Docker)
DATA_DIR=./data
# production = refuse to start without a 12+ character ADMIN_PASSWORD (the Dockerfile sets it)
NODE_ENV=
# On SIGTERM, how long a running Shopify pull may finish before the store is written and the app exits (ms, default 25000)
STOP_WAIT_MS=

# --- Sign-in ---
# Admin password for the page and API (Basic auth: any user name). Required in production and once Shopify is connected
ADMIN_PASSWORD=
# Optional view-only password: sees everything, changes nothing. Must differ from ADMIN_PASSWORD
VIEW_PASSWORD=

# --- Shopify, read-only. DECIDED (option A): the main product's token API (Performity POC API) ---
PERFORMITY_POC_API_URL=
PERFORMITY_POC_API_KEY=
# Only when Performity allows more than one brand for our key
PERFORMITY_BRAND_ID=
# How often to pull from Shopify, minutes (default 120; each pull uses one Performity token call)
SYNC_MINUTES=
# 1.4.0: ShopifyQL reads per pull for the 12-month brand report history (default 8; the first load spreads over pulls)
YEAR_CALLS_PER_RUN=
# 1.4.0: reads allowed for the first 12-month load (default 80: all of it after the first pull)
YEAR_FIRST_CALLS=
# Sent as Origin; must be the domain Performity registered for our key. Blank = https://$RAILWAY_PUBLIC_DOMAIN
PERFORMITY_ORIGIN=
# Old names still read when the two above are blank:
# TOKEN_API_URL=
# TOKEN_API_KEY=

# --- Shopify, other key sources (only one source is used: token API, else Key Vault, else variables) ---
# The store, the part before .myshopify.com (Key Vault and variables need it; the token API takes it from Performity)
SHOPIFY_STORE=
# Option 1: Azure Key Vault, reads shopify-<SHOPIFY_STORE>-client-id and -client-secret
AZURE_KEY_VAULT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Option 2 (stop-gap): the app's client ID + secret as variables (Shopify Dev Dashboard app, same organisation as the store)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Legacy only: a custom-app admin token, if that's all there is
# SHOPIFY_ACCESS_TOKEN=
# Admin API version (default 2026-07)
SHOPIFY_API_VERSION=

# --- Alerts and morning digest (https JSON webhooks, e.g. Slack or Google Chat; env only, never saved from the page) ---
# One message when Shopify pulls start failing, a reminder every 6 h, one on recovery
ALERT_WEBHOOK_URL=
# Morning digest for every role
DIGEST_WEBHOOK_URL=
# A role's own recipient instead: DIGEST_WEBHOOK_URL_<ROLE>, ROLE = CEO, FOUNDER, OPS, MARKETING, FINANCE (the roles with a digest)
# DIGEST_WEBHOOK_URL_CEO=
# The app's address for links in scheduled digests (else https://$RAILWAY_PUBLIC_DOMAIN, else the last address it was opened at)
PUBLIC_URL=
# Set by Railway itself; listed because the digest reads it
# RAILWAY_PUBLIC_DOMAIN=

# --- Which build is running (SW-056: /health, /status, the page footer; not secrets) ---
# Set by Railway on deploys from GitHub
# RAILWAY_GIT_COMMIT_SHA=
# The commit, when Railway doesn't set the one above; or write the BUILD_SHA file with `npm run stamp` before `railway up`
BUILD_SHA=
# backups kept per kind (daily = days back), 1-365, default 14 (SW-055)
KEEP_DAYS=

# --- Dev and test tools only (scripts/stand-in-token-api.js, test/smoke/*.js); never set in production ---
# STAND_IN_KEY=
# SHOPIFY_DEV_TOKEN=
# SHOP_DOMAIN=
# SMOKE_PORT=
# SMOKE_PASSWORD=
# SMOKE_OUT=
# SMOKE_CHROMIUM=
# CHROMIUM_PATH=
# BASE_URL=
# PLAYWRIGHT_PATH=
# PLAYWRIGHT_CHANNEL=
